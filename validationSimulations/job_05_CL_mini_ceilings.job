#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --time=12:00:00
#SBATCH --job-name=saos_05_mini_ceil
#SBATCH --output=saos_05_mini_ceil_%j.out
#SBATCH --error=saos_05_mini_ceil_%j.err
#SBATCH --gres=gpu:1
#SBATCH --mail-type=BEGIN,END
#SBATCH --mail-user=nicolas.linares@iac.es

# Reduced closed loop: integrator and POL gain scans, oracles (perfect prediction with and without the POL error) and stencil/LSTM
# predictors, on-axis WFE only, same atmosphere for all the configurations. 40 runs per sensor (2 atmospheres x 20 configurations).
# Locally ~0.17 s/it (one WFS) and ~0.31 s/it (oracle or --diag runs), i.e. ~2.6 h per sensor for 36x36.

cd ~/code/wfePredictorSAOS/validationSimulations

BASE_DIR="/net/durum/scratch/$USER/simulations"

echo "=== Starting reduced closed-loop ceilings sweep ==="
python -u prepare_assets.py --base_dir "$BASE_DIR"
python -u redArmSolarSCAO_05_CL_mini.py --check_oracle --base_dir "$BASE_DIR"

python -u redArmSolarSCAO_05_CL_mini.py --sweep ceilings --sensors 36 50 --atms atm2 atm4 --base_dir "$BASE_DIR" --skip_existing
python -u analyze_cl_mini.py --results_dir "$BASE_DIR/results/cl_mini"

echo "=== Reduced closed-loop ceilings sweep completed ==="
