#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --time=48:00:00
#SBATCH --job-name=saos_04_sin_cerrar
#SBATCH --output=sin_cerrar_%j.out
#SBATCH --error=sin_cerrar_%j.err
#SBATCH --gres=gpu:1
#SBATCH --mail-type=BEGIN,END
#SBATCH --mail-user=nicolas.linares@iac.es
#SBATCH --qos=long

cd ~/code/wfePredictorSAOS/validationSimulations

BASE_DIR="/net/durum/scratch/$USER/simulations"

echo "=== Starting CL Sin Cerrar (Parallel Open Monitoring) ==="
python -u prepare_assets.py --base_dir "$BASE_DIR"

python -u redArmSolarSCAO_04_CL_sin_cerrar.py --sensor 36 --base_dir "$BASE_DIR" --skip_existing
python -u redArmSolarSCAO_04_CL_sin_cerrar.py --sensor 50 --base_dir "$BASE_DIR" --skip_existing

echo "=== CL Sin Cerrar Completed ==="
