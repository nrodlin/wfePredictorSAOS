#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --time=17:00:00
#SBATCH --job-name=saos_02_base_g05
#SBATCH --output=saos_02_base_g05_%j.out
#SBATCH --error=saos_02_base_g05_%j.err
#SBATCH --gres=gpu:1
#SBATCH --mail-type=BEGIN,END
#SBATCH --mail-user=nicolas.linares@iac.es

# Control run: CL baseline integrator (gain 0.5): checks whether the gain-0.25 baseline is optimal

cd ~/code/wfePredictorSAOS/validationSimulations

BASE_DIR="/net/durum/scratch/$USER/simulations"

echo "=== Starting CL baseline integrator (gain 0.5): checks whether the gain-0.25 baseline is optimal ==="
python -u prepare_assets.py --base_dir "$BASE_DIR"

python -u redArmSolarSCAO_02_CL_baseline.py --sensor 36 --delay 1 --predictor none --gain 0.5 --decay 0.999 --base_dir "$BASE_DIR" --skip_existing
python -u redArmSolarSCAO_02_CL_baseline.py --sensor 50 --delay 1 --predictor none --gain 0.5 --decay 0.999 --base_dir "$BASE_DIR" --skip_existing

echo "=== CL baseline integrator (gain 0.5): checks whether the gain-0.25 baseline is optimal Completed ==="
