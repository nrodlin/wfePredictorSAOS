#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --time=17:00:00
#SBATCH --job-name=saos_03_POL_none_g04
#SBATCH --output=saos_03_POL_none_g04_%j.out
#SBATCH --error=saos_03_POL_none_g04_%j.err
#SBATCH --gres=gpu:1
#SBATCH --mail-type=BEGIN,END
#SBATCH --mail-user=nicolas.linares@iac.es

# Control run: CL POL without predictor (gain 0.4): isolates the effect of the predictor in cl_pol_*_gain0.4

cd ~/code/wfePredictorSAOS/validationSimulations

BASE_DIR="/net/durum/scratch/$USER/simulations"

echo "=== Starting CL POL without predictor (gain 0.4): isolates the effect of the predictor in cl_pol_*_gain0.4 ==="
python -u prepare_assets.py --base_dir "$BASE_DIR"

python -u redArmSolarSCAO_03_CL_POL.py --sensor 36 --predictor none --gain 0.4 --decay 0.999 --base_dir "$BASE_DIR" --skip_existing
python -u redArmSolarSCAO_03_CL_POL.py --sensor 50 --predictor none --gain 0.4 --decay 0.999 --base_dir "$BASE_DIR" --skip_existing

echo "=== CL POL without predictor (gain 0.4): isolates the effect of the predictor in cl_pol_*_gain0.4 Completed ==="
