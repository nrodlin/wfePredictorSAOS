#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --array=0-47:3
#SBATCH --time=03:00:00
#SBATCH --job-name=pred_v2_dataset
#SBATCH --output=pred_v2_dataset_%A_%a.out
#SBATCH --error=pred_v2_dataset_%A_%a.err
#SBATCH --gres=gpu:1
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=nicolas.linares@iac.es

# Dataset v2 of the predictor (generateTrainingData.py), 2000 iterations per run, random conditions drawn from the seed.
# Each array task runs PARALLEL runs at the same time on its GPU (one run uses ~45 % of the GPU and 1.6 GB): indices
# TASK_ID .. TASK_ID+PARALLEL-1, so the array step must equal PARALLEL. ~10-15 min per 36x36 run, ~30 min per 50x50 run.
# Results in $BASE_DIR/results/predictor_dataset_v2/<split>/.
#   sbatch job_dataset_v2.job                                                    train, 36x36, 48 runs (16 tasks x 3)
#   sbatch --array=0-7:4 --export=ALL,SPLIT=val,PARALLEL=4 job_dataset_v2.job        validation, 36x36, 8 runs
#   sbatch --array=0-7:4 --export=ALL,SPLIT=test,PARALLEL=4 job_dataset_v2.job       test, 36x36, 8 runs
#   sbatch --array=0-7:2 --export=ALL,SPLIT=test,SENSOR=50,PARALLEL=2 job_dataset_v2.job   test, 50x50 (never seen in training; larger runs)

cd ~/code/wfePredictorSAOS/simulations
export PYTHONPATH=/home/nlinares/code/SAOS:/home/nlinares/code/wfePredictorSAOS:$PYTHONPATH
PYTHON_CMD="/home/nlinares/.pyenv/versions/3.13.9t/envs/saos/bin/python"
[ -f "$PYTHON_CMD" ] || PYTHON_CMD="python3"
BASE_DIR="/net/durum/scratch/$USER/simulations"
SPLIT=${SPLIT:-train}
SENSOR=${SENSOR:-36}
PARALLEL=${PARALLEL:-3}
FIRST=${SLURM_ARRAY_TASK_ID:?This script is a Slurm array job, submit it with sbatch}

echo "=== Dataset v2: $SPLIT ${SENSOR}x${SENSOR} runs $FIRST..$((FIRST + PARALLEL - 1)) | $(hostname) $(date) ==="
for INDEX in $(seq $FIRST $((FIRST + PARALLEL - 1))); do
    $PYTHON_CMD -u generateTrainingData.py --split $SPLIT --sensor $SENSOR --index $INDEX --base_dir "$BASE_DIR" --skip_existing \
        > "pred_v2_dataset_${SPLIT}_${SENSOR}_${INDEX}.log" 2>&1 &
done
wait
grep -h "<<<\|Traceback\|Error" pred_v2_dataset_${SPLIT}_${SENSOR}_*.log
echo "=== Completed $(date) ==="
